# Verejná adresa nasadenej aplikácie bez lomky na konci.
# V produkcii ju nastavte na https://tournio.sk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verejné údaje projektu Supabase (bezpečné pre klientsku aplikáciu).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Tajný Resend API kľúč iba pre server. Nikdy nepoužívajte prefix NEXT_PUBLIC_.
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=Tournio <noreply@tournio.sk>
